# Schaduwmodus — kopieer naar .env en vul in, of zet ze in je shell.

# Home Assistant. De basis-URL uit je browser volstaat; het volledige
# websocket-eindpunt mag ook, dat wordt herkend.
#   http://homeassistant.local:8123
#   http://192.168.1.20:8123
#   ws://192.168.1.20:8123/api/websocket
HA_URL=http://homeassistant.local:8123

# Long-lived access token. Aan te maken onderaan je HA-profielpagina,
# onder "Langlopende toegangstokens". Behandel dit als een wachtwoord:
# het geeft volledige toegang tot je Home Assistant.
HA_TOKEN=

# Optioneel
SHADOW_TICK_SECONDS=30
# De P1-meter meldt zich elke 5 seconden. Daarop telkens opnieuw beslissen
# heeft geen zin: de regeling werkt met timers van minuten. Deze ondergrens
# houdt het tempo bij ongeveer vier evaluaties per minuut.
SHADOW_MIN_INTERVAL_SECONDS=15
# Sluit zichzelf af wanneer er zoveel minuten geen besluit meer is genomen,
# zodat Docker opnieuw kan starten. Vooral van belang bij onbewaakt draaien:
# een vastgelopen websocket laat het proces leven terwijl de opname stopt.
# Nul zet de bewaking uit.
SHADOW_WATCHDOG_MINUTES=10
SHADOW_LOG_DIR=data/shadow

# --- alleen voor de NAS (docker-compose leest deze) -----------------------
# De poort waarop de read-only webweergave op de NAS te bereiken is.
# Standaard 8099; verzetten als die al bezet is.
#HEMS_WEB_PORT_NAS=8099
# Standaard bereikbaar vanaf je hele thuisnetwerk. Zet op 127.0.0.1 om hem
# alleen vanaf de NAS zelf te kunnen openen.
#HEMS_WEB_BIND=0.0.0.0
