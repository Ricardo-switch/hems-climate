{
  "name": "@hems/backend",
  "version": "0.73.0",
  "private": true,
  "description": "Smart Climate OS - pure decision core plus adapters",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "export:history": "tsx tools/export-history.ts",
    "replay": "tsx tools/onderzoek/run.ts",
    "sweep": "tsx tools/onderzoek/sweep.ts",
    "replay:record": "tsx tools/replay-record.ts",
    "decisions:index": "tsx tools/decision-index.ts",
    "changelog": "tsx tools/changelog.ts",
    "teksten": "tsx tools/teksten.ts",
    "shadow": "tsx src/main.ts",
    "config:check": "tsx tools/check-config.ts",
    "shadow:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shadow.ps1 start",
    "shadow:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shadow.ps1 stop",
    "shadow:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shadow.ps1 restart",
    "shadow:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shadow.ps1 status",
    "shadow:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/shadow.ps1 watch",
    "divergence": "tsx src/divergence/run.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.5",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8",
    "ws": "^8.21.3"
  }
}
