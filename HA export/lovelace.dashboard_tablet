            "content": "{# --- 1. TIJD & WIE IS ER THUIS --- #}  {% set uur = now().hour %}  {% set tijd_groet = 'Goedenacht' if uur < 6 else 'Goedemorgen' if uur < 12 else 'Goedemiddag' if uur < 18 else 'Goedenavond' %}  {% set base_namen = states('sensor.mensen_thuis_tekst') %}  {% set namen_str = ' ' ~ base_namen if base_namen not in ['unknown', 'unavailable', ''] else '' %}\n{# --- 2. AGENDA DATA & FEESTDAGEN (VIA HELPERS) --- #}  {% set werk_dienst = state_attr('sensor.agenda_en_werk_data', 'werk_dienst') | default('') %}  {% set shira_werkt = state_attr('sensor.agenda_en_werk_data', 'shira_werkt') | default(false) %}  {% set ricardo_springdag = state_attr('sensor.agenda_en_werk_data', 'ricardo_springdag') | default(false) %}  {% set events_today = state_attr('sensor.agenda_en_werk_data', 'events_today') | default([]) %}  {% set f1_events = state_attr('sensor.agenda_en_werk_data', 'f1_events') | default([]) %}\n{% set feest_type = states('sensor.vandaag_feestdag_type') %}  {% set jarigen = states('sensor.vandaag_jarigen_tekst') %}\n{% if feest_type == 'verjaardag' and jarigen not in ['unknown', 'unavailable', ''] %}\n  {% set groet = '🎉 Gefeliciteerd met je verjaardag, ' ~ jarigen ~ '!' %}\n{% elif feest_type == 'kerst' %}{% set groet = '🎄 Vrolijk Kerstfeest' ~ namen_str ~ '!' %}  {% elif feest_type == 'oudnieuw' %}{% set groet = '🎆 Gelukkig Nieuwjaar' ~ namen_str ~ '!' %}  {% elif feest_type == 'koningsdag' %}{% set groet = '👑 Fijne Koningsdag' ~ namen_str ~ '!' %}  {% elif feest_type == 'pasen' %}{% set groet = '🐰 Vrolijk Pasen' ~ namen_str ~ '!' %}  {% elif feest_type == 'valentijn' %}{% set groet = '💖 Fijne Valentijnsdag' ~ namen_str ~ '!' %}  {% elif feest_type == 'moederdag' %}{% set groet = '💐 Fijne Moederdag' ~ namen_str ~ '!' %}  {% elif feest_type == 'vaderdag' %}{% set groet = '👔 Fijne Vaderdag' ~ namen_str ~ '!' %}  {% elif feest_type == 'dierendag' %}{% set groet = '🐾 Fijne Dierendag' ~ namen_str ~ '!' %}  {% elif feest_type == 'halloween' %}{% set groet = '🎃 Happy Halloween' ~ namen_str ~ '!' %}  {% else %}{% set groet = tijd_groet ~ namen_str %}{% endif %}\n{# --- 3. LOCATIE & RESET AGENDA --- #}  {% set indent = '&nbsp;&nbsp;&nbsp;&nbsp;' %}  {% set loc_ricardo = states('person.ricardo_cornelissen') | lower %}  {% set loc_shira = states('person.shira') | lower %} {% set is_thuis_ric = (loc_ricardo == 'home') %}  {% set is_thuis_shira = (loc_shira == 'home') %} {% set is_werk_ricardo = ('asml' in loc_ricardo or 'werk' in loc_ricardo) %}  {% set is_werk_shira = ('werk' in loc_shira or 'work' in loc_shira) %}  {% set tijd_nu = now().strftime('%H:%M') %}\n{% if werk_dienst in ['vroege dienst', 'weekenddienst'] and is_thuis_ric and tijd_nu >= '12:00' %}{% set werk_dienst = '' %}  {% elif werk_dienst == 'late dienst' and is_thuis_ric and (tijd_nu >= '22:00' or tijd_nu < '04:00') %}{% set werk_dienst = '' %}{% endif %}  {% if shira_werkt and is_thuis_shira and tijd_nu >= '13:00' %}{% set shira_werkt = false %}{% endif %}\n{# --- 4. BEPAAL HEENREIS TIJDEN --- #} {% set toon_naar_werk = false %} {% if werk_dienst != '' %}\n  {% set toon_naar_werk = (werk_dienst == 'vroege dienst' and '04:10' <= tijd_nu < '12:00') or (werk_dienst == 'late dienst' and '12:40' <= tijd_nu < '18:00') or (werk_dienst == 'weekenddienst' and '04:40' <= tijd_nu < '12:00') %}\n{% endif %}\n{# --- 5. SCENARIO 2: ONDERWEG (ETA LOGICA) --- #}  {% set auto_ricardo = is_state('binary_sensor.pixel_8_pro_android_auto', 'on') %}\n{# Afstand berekenen we nog stiekem op de achtergrond voor de \"Samen reizen\" check #} {% set dist_ric = distance('person.ricardo_cornelissen') | float(0) %} {% set dist_shi = distance('person.shira') | float(0) %} {% set dist_diff = (dist_ric - dist_shi) | abs %}\n{% set prox_thuis = states('sensor.thuis_nearest_distance') | float(-1) %}  {% set prox_richting = states('sensor.thuis_nearest_direction_of_travel') | default('') %}  {% set prox_naam = states('sensor.thuis_nearest_device') | default('') | lower %} \n{% set onderweg_zinnen = [] %} {% set ns_rit = namespace(ricardo_werk=false, shira_werk=false) %}\n{# Is Ricardo rijdend onderweg? (Niet als hij nog in de werkzone is!) #} {% set ric_onderweg = auto_ricardo and not is_thuis_ric and not is_werk_ricardo and not toon_naar_werk %}\n{# Is Shira onderweg? (Niet als ze nog in de werkzone is!) #} {% set shi_onderweg = false %} {% if not is_thuis_shira and not is_werk_shira %}\n  {% if ric_onderweg and is_state('person.shira', 'not_home') and dist_diff < 0.3 %}\n    {% set shi_onderweg = true %}\n  {% elif prox_richting == 'towards' and 'shira' in prox_naam %}\n    {% set shi_onderweg = true %}\n  {% endif %}\n{% endif %}\n{# REIZEN ZE SAMEN IN DEZELFDE AUTO? (Verschil in afstand < 300 meter) #} {% set reizen_samen = ric_onderweg and shi_onderweg and dist_diff < 0.3 %}\n{% if reizen_samen %}\n  {% set ns_rit.ricardo_werk = (werk_dienst != '') %}\n  {% set ns_rit.shira_werk = (shira_werkt) %}\n  {% set reistijd_terug = states('sensor.ricardo_actuele_reistijd') | float(0) | round(0) | int if states('sensor.ricardo_actuele_reistijd') | is_number else '--' %}\n  \n  {% set basis_tekst = '🚗 <b>Ricardo en Shira</b> zijn onderweg naar huis' %}\n  {% if ns_rit.ricardo_werk or ns_rit.shira_werk %}\n    {% set basis_tekst = basis_tekst ~ ' vanaf werk.' %}\n  {% else %}\n    {% set basis_tekst = basis_tekst ~ '.' %}\n  {% endif %}\n\n  {% if reistijd_terug != '--' %}\n    {% set eta_tijd = (now() + timedelta(minutes=reistijd_terug)).strftime('%H:%M') %}\n    {% if reistijd_terug >= 65 and ns_rit.ricardo_werk %}\n      {% set onderweg_zinnen = onderweg_zinnen + ['<span style=\"color: #ff4d4d;\">' ~ basis_tekst ~ ' Verwachte aankomst: ' ~ eta_tijd ~ ' ⚠️ (+' ~ (reistijd_terug - 55) ~ ' min file).</span>'] %}\n    {% else %}\n      {% set onderweg_zinnen = onderweg_zinnen + [basis_tekst ~ ' Verwachte aankomst: ' ~ eta_tijd ~ '.'] %}\n    {% endif %}\n  {% else %}\n    {% set onderweg_zinnen = onderweg_zinnen + [basis_tekst] %}\n  {% endif %}\n\n{% else %}\n  {# REIZEN APART: GEEF IEDER EEN EIGEN ZIN #}\n  \n  {# Zin voor Ricardo #}\n  {% if ric_onderweg %}\n    {% set ns_rit.ricardo_werk = (werk_dienst != '') %}\n    {% set reistijd_terug = states('sensor.ricardo_actuele_reistijd') | float(0) | round(0) | int if states('sensor.ricardo_actuele_reistijd') | is_number else '--' %}\n    \n    {% set ric_tekst = '🚗 <b>Ricardo</b> is onderweg naar huis' %}\n    {% if ns_rit.ricardo_werk %}\n      {% set ric_tekst = ric_tekst ~ ' vanaf werk.' %}\n    {% else %}\n      {% set ric_tekst = ric_tekst ~ '.' %}\n    {% endif %}\n\n    {% if reistijd_terug != '--' %}\n      {% set eta_tijd = (now() + timedelta(minutes=reistijd_terug)).strftime('%H:%M') %}\n      {% if reistijd_terug >= 65 and ns_rit.ricardo_werk %}\n        {% set onderweg_zinnen = onderweg_zinnen + ['<span style=\"color: #ff4d4d;\">' ~ ric_tekst ~ ' Verwachte aankomst: ' ~ eta_tijd ~ ' ⚠️ (+' ~ (reistijd_terug - 55) ~ ' min file).</span>'] %}\n      {% else %}\n        {% set onderweg_zinnen = onderweg_zinnen + [ric_tekst ~ ' Verwachte aankomst: ' ~ eta_tijd ~ '.'] %}\n      {% endif %}\n    {% else %}\n      {% set onderweg_zinnen = onderweg_zinnen + [ric_tekst] %}\n    {% endif %}\n  {% endif %}\n\n  {# Zin voor Shira #}\n  {% if shi_onderweg %}\n    {% set ns_rit.shira_werk = (shira_werkt) %}\n    {% set shi_tekst = '🚗 <b>Shira</b> is onderweg naar huis' %}\n    {% if ns_rit.shira_werk %}\n      {% set shi_tekst = shi_tekst ~ ' vanaf werk.' %}\n    {% else %}\n      {% set shi_tekst = shi_tekst ~ '.' %}\n    {% endif %}\n    \n    {% set onderweg_zinnen = onderweg_zinnen + [shi_tekst] %}\n  {% endif %}\n{% endif %}\n{# --- 6. BEPAAL WERK ZINNEN --- #} {% set r_part = '' %} {% if is_werk_ricardo %}\n  {% set r_part = 'Ricardo is momenteel aan het werk' %}\n{% elif ns_rit.ricardo_werk %}\n  {# Verborgen: Ricardo rijdt al naar huis vanaf werk, dus geen werk-zin tonen #}\n{% elif werk_dienst != '' %}\n  {% set r_part = 'Ricardo heeft ' ~ werk_dienst %}\n{% elif ricardo_springdag %}\n  {% set r_part = 'Ricardo heeft Springdag' %}\n{% endif %}\n{% set s_part = '' %} {% if is_werk_shira %}\n  {% set s_part = 'Shira is momenteel aan het werk' %}\n{% elif ns_rit.shira_werk %}\n  {# Verborgen: Shira is onderweg naar huis vanaf werk #}\n{% elif shira_werkt %}\n  {% set s_part = 'Shira moet werken' %}\n{% endif %}\n{% set werk_tekst = '' %} {% set werk_icon = '✨' %} {% set shira_icon = '🍟' %}\n{% if r_part != '' and s_part != '' %}\n  {% if is_werk_ricardo and is_werk_shira %}\n    {% set werk_tekst = 'Ricardo en Shira zijn momenteel aan het werk.' %}\n    {% set werk_icon = '🏭 / ' ~ shira_icon %}\n  {% else %}\n    {% set toevoeging = ' vandaag.' if not is_werk_ricardo and not is_werk_shira else '.' %}\n    {% set werk_tekst = r_part ~ ' en ' ~ s_part ~ toevoeging %}\n    {% set werk_icon = '🏭 / ' ~ shira_icon %}\n  {% endif %}\n{% elif r_part != '' %}\n  {% set toevoeging = '.' if is_werk_ricardo else ' vandaag.' %}\n  {% set werk_tekst = r_part ~ toevoeging %}\n  {% set werk_icon = '🏭' if not ricardo_springdag or werk_dienst else '🛋️' %}\n{% elif s_part != '' %}\n  {% set toevoeging = '.' if is_werk_shira else ' vandaag.' %}\n  {% set werk_tekst = s_part ~ toevoeging %}\n  {% set werk_icon = shira_icon %}\n{% endif %}\n{# --- 7. HEENREIS NAAR WERK (ASML) --- #}  {% set reistijd_tekst = '' %}  {% if toon_naar_werk and not is_werk_ricardo %}\n  {% set reistijd_heen = states('sensor.asml_reistijd') | float(0) | round(0) | int if states('sensor.asml_reistijd') | is_number else '--' %}\n  {% if reistijd_heen != '--' %}\n    {% if reistijd_heen >= 65 %}\n      {% set reistijd_tekst = '<span style=\"color: #ff4d4d;\">🚗 Reistijd naar werk: ' ~ reistijd_heen ~ ' minuten ⚠️ (+' ~ (reistijd_heen - 55) ~ ' min file)</span>' %}\n    {% else %}\n      {% set reistijd_tekst = '🚗 Reistijd naar werk: ' ~ reistijd_heen ~ ' minuten' %}\n    {% endif %}\n  {% endif %}\n{% endif %}\n{# --- 8. SUBTEXT MELDINGEN (TODO, AFVAL, AIRCO, PAKKET, ACCU, WEER) --- #}  {% set subtext_parts = [] %}\n{# Haal de originele lijst op en filter de afval-taak eruit #} {% set totaal_todo_count = states('sensor.to_do_lijst_items') | int(0) %} {% set ruwe_taken = state_attr('sensor.to_do_lijst_items', 'taken_lijst') | default([]) %}\n{% set ns_todo = namespace(afval_count=0) %} {% for taak in ruwe_taken %}\n  {% if 'afval' in taak | lower %}\n    {% set ns_todo.afval_count = ns_todo.afval_count + 1 %}\n  {% endif %}\n{% endfor %}\n{# Bepaal het nieuwe totaal zonder het afval #} {% set todo_count = totaal_todo_count - ns_todo.afval_count %} {% if todo_count < 0 %}{% set todo_count = 0 %}{% endif %}\n{# Nieuwe melding voor taken: alleen tekst met aantallen #} {% if todo_count > 0 %}\n  {% set link_begin = '<a href=\"/todo\" style=\"color: white; text-decoration: none;\">' %}\n  {% if todo_count == 1 %}\n    {% set subtext_parts = subtext_parts + [link_begin ~ '📝 Er is nog <b>1 openstaande taak</b>.</a>'] %}\n  {% else %}\n    {% set subtext_parts = subtext_parts + [link_begin ~ '📝 Er zijn nog <b>' ~ todo_count ~ ' openstaande taken</b>.</a>'] %}\n  {% endif %}\n{% endif %}\n{# Afval Check incl boolean check #} {% set afval_namen = states('sensor.afval_vandaag_namen') %} {% set afval_gedaan = is_state('input_boolean.afval_buiten_gezet', 'on') %}\n{% if afval_namen not in ['unknown', 'unavailable', '', 'geen'] and not afval_gedaan %}\n  {% set subtext_parts = subtext_parts + ['🗑️ <b>Vergeet het afval niet:</b> ' ~ afval_namen ~ ' moet aan de straat!'] %}\n{% endif %}\n{% set ns_airco = namespace(schoonmaken=[]) %}  {% if states('sensor.air_conditioning_woonkamer_filter_remaining_life') | int(100) < 20 %}{% set ns_airco.schoonmaken = ns_airco.schoonmaken + ['Woonkamer'] %}{% endif %}  {% if states('sensor.air_conditioning_zolder_filter_remaining_life') | int(100) < 20 %}{% set ns_airco.schoonmaken = ns_airco.schoonmaken + ['Zolder'] %}{% endif %}  {% if ns_airco.schoonmaken | length > 0 %}{% set subtext_parts = subtext_parts + ['💨 <b>Airco:</b> Filter schoonmaken (' ~ (ns_airco.schoonmaken | join(' & ')) ~ ')!'] %}{% endif %}\n{% set pakket_onderweg = states('sensor.17track_onderweg') | int(0) %}  {% set pakket_ophalen = states('sensor.17track_klaar_om_opgehaald_te_worden') | int(0) %}  {% set pakket_geleverd = states('sensor.17track_geleverd') | int(0) %}  {% set totaal_pakketten = pakket_onderweg + pakket_ophalen + pakket_geleverd %}  {% if totaal_pakketten > 0 %}\n  {% set p_txt = [] %}\n  {% if pakket_onderweg > 0 %}{% set p_txt = p_txt + ['<b>' ~ pakket_onderweg ~ '</b> onderweg'] %}{% endif %}\n  {% if pakket_ophalen > 0 %}{% set p_txt = p_txt + ['<b>' ~ pakket_ophalen ~ '</b> klaar om af te halen'] %}{% endif %}\n  {% if pakket_geleverd > 0 %}{% set p_txt = p_txt + ['<b>' ~ pakket_geleverd ~ '</b> zojuist geleverd'] %}{% endif %}\n  {% set subtext_parts = subtext_parts + ['📦 <b>Pakketjes:</b> Er ' ~ ('is' if totaal_pakketten == 1 else 'zijn') ~ ' momenteel ' ~ (p_txt | join(', ') | replace('</b> ', '</b> pakketje(s) ' ~ '')) ~ '.'] %}\n{% endif %}\n{% if states('sensor.lege_smart_batterijen') | int(0) > 0 %}\n  {% set bat_link = '<a href=\"batterijen\" style=\"color: white; text-decoration: none;\">' %}\n  {% set subtext_parts = subtext_parts + [bat_link ~ '🔋 <b>Let op:</b> De batterij is bijna leeg van:<br><b>' ~ states('sensor.lege_smart_batterijen_namen') ~ '</b></a>'] %}\n{% endif %}\n{% set droger = states('sensor.droger_status_tekst') %}  {% if droger not in ['off', 'unknown', 'unavailable'] %}{% set subtext_parts = subtext_parts + [droger] %}{% endif %}\n{% if f1_events | length > 0 %}{% set subtext_parts = subtext_parts + f1_events %}{% endif %}  {% set subtext_parts = subtext_parts + [states('sensor.dashboard_weer_zin')] %}\n{# --- 9. RENDEREN HTML --- #}  <h1>{{ groet }}</h1>\n{% if werk_tekst != '' %} <h3>{{ werk_icon }} {{ werk_tekst }}</h3> {% endif %}\n{# Heenreis naar werk #} {% if reistijd_tekst != '' %} <p>{{ indent if werk_tekst != '' else '' }}{{ reistijd_tekst }}</p> {% endif %}\n{# De gecombineerde OF losse terugreis zinnen #} {% if onderweg_zinnen | length > 0 %} <h3 style=\"margin-top: 8px !important;\">{{ onderweg_zinnen | join('<br>') }}</h3> {% endif %}\n<br>  {% if werk_tekst != '' or onderweg_zinnen | length > 0 %} \n  {% if events_today | length > 0 %} <h4>📅 Overige afspraken:</h4> <p>{{ indent }}• {{ events_today | join('<br>' ~ indent ~ '• ') }}</p> \n  {% else %} <h4>☕ Geen verdere afspraken vandaag.</h4> {% endif %} \n{% else %} \n  {% if events_today | length > 0 %} <h3>📅 Je geplande afspraken voor vandaag:</h3> <p>{{ indent }}• {{ events_today | join('<br>' ~ indent ~ '• ') }}</p> \n  {% else %} <h3>☕ Je agenda is momenteel leeg. Tijd om lekker te ontspannen!</h3> {% endif %} \n{% endif %}\n<hr> <p>{{ subtext_parts | join('<br><br>') }}</p>",
